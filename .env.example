# ── PostgreSQL (Neon) ─────────────────────────────────────────────────────────
# Get your connection string from: https://neon.tech
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/zentro?sslmode=require

# ── Cloudflare R2 (product photos, logos, documents) ─────────────────────────
# Create a bucket at: https://dash.cloudflare.com → R2 → Create bucket
# Enable "Public access" on the bucket and note the public URL
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=zentro-assets
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ── CORS (set when frontend is on a different domain) ────────────────────────
# Comma-separated list of allowed frontend origins
# CORS_ORIGIN=https://zentrobm.rw,https://admin.zentrobm.rw

# ── Google OAuth (optional) ───────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxx
# GOOGLE_REDIRECT_URI=https://api.zentrobm.rw/api/auth/google/callback

# ── Email / SMTP (optional — for loan reminders, contact form) ───────────────
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=SG.xxxx
# SMTP_FROM=noreply@zentrobm.rw
# CONTACT_EMAIL=info@zentrobm.rw
